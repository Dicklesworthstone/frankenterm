{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wezterm-automata.dev/schemas/wa-robot-events.json",
  "title": "WA Robot Events Response",
  "description": "Schema for the data field when calling 'wa robot events'. Returns recent detected events and optional workflow previews.",
  "type": "object",
  "required": ["events", "total_count", "limit", "unhandled_only"],
  "properties": {
    "events": {
      "type": "array",
      "description": "Recent events; cursor mode is ordered by ascending durable event ID, while non-cursor mode returns the legacy recent-event order",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "total_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of events returned"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096,
      "description": "Maximum events returned"
    },
    "cursor": {
      "type": "integer",
      "minimum": 0,
      "description": "Exclusive durable event-ID checkpoint supplied by the caller"
    },
    "cursor_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "Retention epoch paired with cursor; IDs are not authoritative without it"
    },
    "cursor_scope": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 membership-scope fingerprint paired with cursor"
    },
    "next_cursor": {
      "type": "integer",
      "minimum": 0,
      "description": "Authoritative inclusive checkpoint through the examined page"
    },
    "next_cursor_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "Retention epoch that must be supplied with next_cursor on resume"
    },
    "next_cursor_scope": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Membership-scope fingerprint that must be supplied with next_cursor on resume"
    },
    "replay_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096,
      "description": "Explicit bounded cursor replay window"
    },
    "order": {
      "type": "string",
      "enum": ["id_asc"],
      "description": "Ordering contract used by cursor mode"
    },
    "start_at_tail": {
      "const": true,
      "description": "The response established an atomic fresh cursor at the durable event tail without replaying history"
    },
    "cursor_capability": {
      "type": "string",
      "enum": ["non_resumable_newest_first_snapshot"],
      "description": "Explicit capability marker used by wa.events while that MCP surface exposes only a non-resumable newest-first snapshot"
    },
    "pane_filter": {
      "type": "integer",
      "minimum": 0,
      "description": "If set, events were filtered to this pane_id"
    },
    "rule_id_filter": {
      "type": "string",
      "description": "If set, events were filtered to this rule_id"
    },
    "event_type_filter": {
      "type": "string",
      "description": "If set, events were filtered to this event_type"
    },
    "triage_state_filter": {
      "type": "string",
      "description": "If set, events were filtered to this triage_state"
    },
    "label_filter": {
      "type": "string",
      "description": "If set, events were filtered to those with this label"
    },
    "type_filter": {
      "type": "string",
      "description": "Deprecated alias for event_type_filter"
    },
    "unhandled_only": {
      "type": "boolean",
      "description": "If true, only unhandled events were returned"
    },
    "since_filter": {
      "type": "integer",
      "minimum": 0,
      "description": "If set, events were filtered to those detected after this timestamp (ms)"
    },
    "would_handle": {
      "type": "boolean",
      "description": "If true, per-event workflow previews are included"
    },
    "dry_run": {
      "type": "boolean",
      "description": "If true, this was a dry-run preview (no workflows executed)"
    }
  },
  "dependentRequired": {
    "cursor": ["cursor_epoch", "cursor_scope"],
    "cursor_epoch": ["cursor", "cursor_scope"],
    "cursor_scope": ["cursor", "cursor_epoch"],
    "next_cursor": ["next_cursor_epoch", "next_cursor_scope"],
    "next_cursor_epoch": ["next_cursor", "next_cursor_scope"],
    "next_cursor_scope": ["next_cursor", "next_cursor_epoch"],
    "replay_limit": ["cursor", "cursor_epoch", "cursor_scope"]
  },
  "allOf": [
    {
      "if": { "required": ["cursor"] },
      "then": {
        "required": ["next_cursor", "next_cursor_epoch", "next_cursor_scope", "order"]
      }
    },
    {
      "if": { "required": ["next_cursor"] },
      "then": { "required": ["order"] }
    },
    {
      "if": { "required": ["start_at_tail"] },
      "then": {
        "required": ["next_cursor", "next_cursor_epoch", "next_cursor_scope", "order"],
        "properties": {
          "events": { "maxItems": 0 }
        },
        "not": { "required": ["cursor"] }
      }
    },
    {
      "if": { "required": ["order"] },
      "then": {
        "anyOf": [
          { "required": ["cursor"] },
          { "required": ["start_at_tail"] }
        ]
      }
    },
    {
      "if": { "required": ["cursor_capability"] },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["cursor"] },
            { "required": ["cursor_epoch"] },
            { "required": ["cursor_scope"] },
            { "required": ["next_cursor"] },
            { "required": ["next_cursor_epoch"] },
            { "required": ["next_cursor_scope"] },
            { "required": ["replay_limit"] },
            { "required": ["order"] },
            { "required": ["start_at_tail"] }
          ]
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "description": "A detected event from pattern matching",
      "required": ["id", "pane_id", "rule_id", "pack_id", "event_type", "severity", "confidence", "captured_at"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "description": "Unique event identifier"
        },
        "pane_id": {
          "type": "integer",
          "minimum": 0,
          "description": "Pane where the event was detected"
        },
        "rule_id": {
          "type": "string",
          "description": "Pattern rule that matched (e.g., 'core.codex:usage_warning_25')"
        },
        "pack_id": {
          "type": "string",
          "description": "Pattern pack identifier"
        },
        "agent_type": {
          "type": "string",
          "enum": ["codex", "claude_code", "gemini", "wezterm", "unknown"],
          "description": "Type of agent detected in the pane"
        },
        "event_type": {
          "type": "string",
          "description": "Category of event (e.g., 'usage.warning', 'session.compaction')"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error", "critical"],
          "description": "Event severity level"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence (0.0 to 1.0)"
        },
        "extracted": {
          "type": "object",
          "description": "Values extracted from the matched pattern (e.g., percentage, token counts)",
          "additionalProperties": true
        },
        "annotations": {
          "$ref": "#/$defs/annotations",
          "description": "Optional persisted annotations (triage state, note, labels)"
        },
        "matched_text": {
          "type": "string",
          "description": "The text that matched the pattern (may be redacted)"
        },
        "captured_at": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix timestamp (ms) when the event was detected"
        },
        "handled_at": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Unix timestamp (ms) when the event was handled (null if unhandled)"
        },
        "workflow_id": {
          "type": ["string", "null"],
          "description": "ID of the workflow execution that handled this event"
        },
        "would_handle_with": {
          "$ref": "#/$defs/would_handle_with",
          "description": "Preview of the workflow that would handle this event (if requested)"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "type": "object",
      "description": "Persisted annotations for an event",
      "properties": {
        "triage_state": { "type": ["string", "null"] },
        "triage_updated_at": { "type": ["integer", "null"] },
        "triage_updated_by": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "note_updated_at": { "type": ["integer", "null"] },
        "note_updated_by": { "type": ["string", "null"] },
        "labels": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["labels"],
      "additionalProperties": false
    },
    "would_handle_with": {
      "type": "object",
      "description": "Workflow preview for an event",
      "required": ["workflow"],
      "properties": {
        "workflow": {
          "type": "string",
          "description": "Workflow name"
        },
        "preview_command": {
          "type": "string",
          "description": "Preview command to run this workflow"
        },
        "first_step": {
          "type": "string",
          "description": "First step name in the workflow"
        },
        "estimated_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated total workflow duration (ms)"
        },
        "would_run": {
          "type": "boolean",
          "description": "Whether this workflow would auto-run given current config/state"
        },
        "reason": {
          "type": "string",
          "description": "Reason the workflow would not run (if applicable)"
        }
      },
      "additionalProperties": false
    }
  }
}
