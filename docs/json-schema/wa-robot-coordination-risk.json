{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wezterm-automata.dev/schemas/wa-robot-coordination-risk.json",
  "title": "WA Robot Coordination Risk Snapshot",
  "description": "Schema for the data field when calling 'ft robot coordination-risk'. The payload is produced by scripts/swarm-tick.sh --agent-mail-fallback and wrapped in the standard robot envelope.",
  "type": "object",
  "required": [
    "ts",
    "session",
    "mode",
    "agent_mail",
    "beads",
    "git",
    "next_actions",
    "proof_doctor"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "description": "UTC timestamp generated by the fallback producer."
    },
    "session": {
      "type": "string",
      "description": "Swarm session name used for the snapshot."
    },
    "mode": {
      "const": "agent_mail_unavailable_beads_only"
    },
    "agent_mail": {
      "type": "object",
      "required": ["status", "marker", "forbidden_actions"],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "marker": {
          "type": "string"
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "beads": {
      "type": "object",
      "required": [
        "in_progress_count",
        "ready_count",
        "active_agents",
        "in_progress",
        "stale_reopen",
        "ready"
      ],
      "properties": {
        "in_progress_count": {
          "type": "integer",
          "minimum": 0
        },
        "ready_count": {
          "type": "integer",
          "minimum": 0
        },
        "active_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/active_agent"
          }
        },
        "in_progress": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bead_ref"
          }
        },
        "stale_reopen": {
          "$ref": "#/$defs/stale_reopen"
        },
        "ready": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ready_bead"
          }
        }
      },
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "required": [
        "dirty_count",
        "tracked_dirty_count",
        "untracked_dirty_count",
        "high_risk_count",
        "risk_level",
        "risk_reason",
        "dirty_domains",
        "dirty_paths",
        "conflict_hints"
      ],
      "properties": {
        "dirty_count": {
          "type": "integer",
          "minimum": 0
        },
        "tracked_dirty_count": {
          "type": "integer",
          "minimum": 0
        },
        "untracked_dirty_count": {
          "type": "integer",
          "minimum": 0
        },
        "high_risk_count": {
          "type": "integer",
          "minimum": 0
        },
        "risk_level": {
          "enum": ["clean", "low", "medium", "high"]
        },
        "risk_reason": {
          "type": "string"
        },
        "dirty_domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dirty_domain"
          }
        },
        "dirty_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dirty_path"
          }
        },
        "conflict_hints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict_hint"
          }
        }
      },
      "additionalProperties": false
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_doctor": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nullable_integer": {
      "type": ["integer", "null"]
    },
    "nullable_string": {
      "type": ["string", "null"]
    },
    "bead_ref": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "priority",
        "assignee",
        "updated_at",
        "age_seconds",
        "stale_over_2h"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/nullable_string"
        },
        "priority": {
          "$ref": "#/$defs/nullable_integer"
        },
        "assignee": {
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/nullable_string"
        },
        "age_seconds": {
          "$ref": "#/$defs/nullable_integer"
        },
        "stale_over_2h": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ready_bead": {
      "type": "object",
      "required": ["id", "title", "status", "priority", "assignee"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/nullable_integer"
        },
        "assignee": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "active_agent": {
      "type": "object",
      "required": ["assignee", "active_count", "beads"],
      "properties": {
        "assignee": {
          "type": "string"
        },
        "active_count": {
          "type": "integer",
          "minimum": 0
        },
        "beads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "updated_at",
              "age_seconds",
              "stale_over_2h"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "updated_at": {
                "$ref": "#/$defs/nullable_string"
              },
              "age_seconds": {
                "$ref": "#/$defs/nullable_integer"
              },
              "stale_over_2h": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "stale_reopen": {
      "type": "object",
      "required": [
        "default_action",
        "threshold_seconds",
        "dirty_risk_level",
        "high_risk_dirty_count",
        "dirty_tree_guard",
        "manual_checks",
        "active_not_stale",
        "candidates",
        "dirty_overlap_unknown"
      ],
      "properties": {
        "default_action": {
          "const": "do_not_reopen"
        },
        "threshold_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "dirty_risk_level": {
          "enum": ["clean", "low", "medium", "high"]
        },
        "high_risk_dirty_count": {
          "type": "integer",
          "minimum": 0
        },
        "dirty_tree_guard": {
          "type": "string"
        },
        "manual_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "active_not_stale": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reopen_item"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reopen_candidate"
          }
        },
        "dirty_overlap_unknown": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dirty_overlap"
          }
        }
      },
      "additionalProperties": false
    },
    "reopen_item": {
      "type": "object",
      "required": [
        "id",
        "title",
        "assignee",
        "updated_at",
        "age_seconds",
        "recommendation",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "assignee": {
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/nullable_string"
        },
        "age_seconds": {
          "$ref": "#/$defs/nullable_integer"
        },
        "recommendation": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "reopen_candidate": {
      "type": "object",
      "required": [
        "id",
        "title",
        "assignee",
        "updated_at",
        "age_seconds",
        "recommendation",
        "reason",
        "required_evidence",
        "status_check_command",
        "reopen_command"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "assignee": {
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/nullable_string"
        },
        "age_seconds": {
          "$ref": "#/$defs/nullable_integer"
        },
        "recommendation": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status_check_command": {
          "type": "string"
        },
        "reopen_command": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dirty_path": {
      "type": "object",
      "required": ["raw", "status", "path", "category", "severity"],
      "properties": {
        "raw": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/dirty_category"
        },
        "severity": {
          "$ref": "#/$defs/dirty_severity"
        }
      },
      "additionalProperties": false
    },
    "dirty_domain": {
      "type": "object",
      "required": ["category", "severity", "count", "paths"],
      "properties": {
        "category": {
          "$ref": "#/$defs/dirty_category"
        },
        "severity": {
          "$ref": "#/$defs/dirty_severity"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "conflict_hint": {
      "type": "object",
      "required": ["path", "status", "category", "severity", "guidance"],
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/dirty_category"
        },
        "severity": {
          "$ref": "#/$defs/dirty_severity"
        },
        "guidance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dirty_overlap": {
      "type": "object",
      "required": ["path", "status", "category", "severity", "recommendation"],
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/dirty_category"
        },
        "severity": {
          "$ref": "#/$defs/dirty_severity"
        },
        "recommendation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dirty_category": {
      "enum": [
        "shared_tracker",
        "tracked_overlap_risk",
        "untracked_review_required",
        "janitor_untracked"
      ]
    },
    "dirty_severity": {
      "enum": ["low", "medium", "high"]
    }
  }
}
