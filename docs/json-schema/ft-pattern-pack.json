{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankenterm.dev/json-schema/ft-pattern-pack.json",
  "title": "FrankenTerm Pattern Pack (v1)",
  "description": "Hand-authored from crates/frankenterm-core/src/patterns.rs:619 (PatternPack) and :487 (RuleDef). Tracked under ft-b35tw. The companion spec lives at docs/patterns-pack-format.md.",
  "type": "object",
  "required": ["name", "version", "rules"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Pack identifier. Built-in packs use a `builtin:` prefix; user packs use a plain or namespaced name. MUST be non-empty after trimming."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Pack version. Treated as opaque by the loader; semver-like strings are conventional."
    },
    "rules": {
      "type": "array",
      "description": "Rules in this pack. Every rule's `id` MUST be unique within the array.",
      "items": { "$ref": "#/$defs/Rule" }
    },
    "supply_chain": {
      "oneOf": [
        { "$ref": "#/$defs/SupplyChain" },
        { "type": "null" }
      ],
      "description": "Optional supply-chain verification manifest for user or extension pattern packs."
    }
  },
  "$defs": {
    "Rule": {
      "type": "object",
      "required": [
        "id",
        "agent_type",
        "event_type",
        "severity",
        "anchors",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Stable rule identifier. SHOULD use a `<agent>.<feature>.<event>` dotted convention."
        },
        "agent_type": { "$ref": "#/$defs/AgentType" },
        "event_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Event-type label emitted on match (e.g. `usage_limit`, `compaction_required`)."
        },
        "severity": { "$ref": "#/$defs/Severity" },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": "Literal substrings used by the Aho-Corasick quick-reject pass. SHOULD include at least one anchor."
        },
        "regex": {
          "type": ["string", "null"],
          "description": "Optional extraction regex. Named captures (`(?P<name>...)`) are preferred."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Human-readable description shown in `ft why <rule_id>`."
        },
        "remediation": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S",
          "description": "Suggested remediation text."
        },
        "workflow": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S",
          "description": "Suggested workflow name to invoke (e.g. `handle_usage_limits`)."
        },
        "manual_fix": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S",
          "description": "Manual fix instructions for environments where workflow execution is unavailable."
        },
        "preview_command": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S",
          "description": "Preview command template supporting `{pane}`, `{event_id}`, `{agent}` interpolation."
        },
        "learn_more_url": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S",
          "description": "URL for additional documentation about this rule."
        }
      }
    },
    "SupplyChain": {
      "type": "object",
      "required": [
        "provenance",
        "lint",
        "regex_backtrack_budget",
        "redaction_review",
        "compatibility_target",
        "rollout"
      ],
      "additionalProperties": false,
      "properties": {
        "provenance": { "$ref": "#/$defs/SupplyChainProvenance" },
        "fixture_hashes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "lint": { "$ref": "#/$defs/SupplyChainLint" },
        "regex_backtrack_budget": {
          "type": "integer",
          "minimum": 0
        },
        "redaction_review": { "$ref": "#/$defs/SupplyChainRedactionReview" },
        "compatibility_target": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rollout": { "$ref": "#/$defs/SupplyChainRollout" },
        "signature": {
          "oneOf": [
            { "$ref": "#/$defs/SupplyChainSignature" },
            { "type": "null" }
          ]
        }
      }
    },
    "SupplyChainProvenance": {
      "type": "object",
      "required": ["author", "source", "revision"],
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "SupplyChainLint": {
      "type": "object",
      "required": ["passed"],
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/NonBlankString" }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/NonBlankString" }
        }
      }
    },
    "SupplyChainRedactionReview": {
      "type": "object",
      "required": ["reviewer", "reviewed_at", "approved"],
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewed_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "approved": { "type": "boolean" }
      }
    },
    "SupplyChainRollout": {
      "type": "object",
      "required": [
        "stage",
        "dry_run_match_telemetry",
        "observe_only_until_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "dry_run_match_telemetry": { "type": "boolean" },
        "observe_only_until_verified": { "type": "boolean" }
      }
    },
    "SupplyChainSignature": {
      "type": "object",
      "required": ["algorithm", "signer", "payload_sha256", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "signer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "value": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "NonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "AgentType": {
      "type": "string",
      "enum": ["codex", "claude_code", "gemini", "wezterm", "unknown"],
      "description": "Snake-case serialization of frankenterm_core::patterns::AgentType."
    },
    "Severity": {
      "type": "string",
      "enum": ["info", "warning", "critical"],
      "description": "Snake-case serialization of frankenterm_core::patterns::Severity."
    }
  }
}
