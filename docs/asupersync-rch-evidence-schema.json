{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ft.rch.proof-ledger.evidence.schema.v2",
  "title": "FrankenTerm RCH Proof Ledger Evidence Schema",
  "type": "object",
  "required": [
    "schema_version",
    "bead_id",
    "policy_version",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "bead_id": {
      "type": "string",
      "pattern": "^ft-[A-Za-z0-9][A-Za-z0-9-]*(\\.[A-Za-z0-9][A-Za-z0-9-]*)*$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "command",
          "command_class",
          "is_heavy",
          "used_rch",
          "worker_context",
          "execution_mode",
          "target_dir",
          "target_dir_lifecycle",
          "artifact_paths",
          "elapsed_seconds",
          "exit_status",
          "residual_risk_notes",
          "validation_status"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "command_class": {
            "type": "string",
            "enum": [
              "heavy",
              "light"
            ]
          },
          "is_heavy": {
            "type": "boolean"
          },
          "used_rch": {
            "type": "boolean"
          },
          "worker_context": {
            "type": "string",
            "minLength": 1
          },
          "execution_mode": {
            "type": "string",
            "enum": [
              "remote_rch",
              "local_light",
              "approved_local_fallback"
            ]
          },
          "target_dir": {
            "type": "string",
            "minLength": 1
          },
          "target_dir_lifecycle": {
            "type": "string",
            "enum": [
              "not_applicable",
              "retained",
              "inventory_only",
              "cleanup_approved"
            ]
          },
          "artifact_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "exit_status": {
            "type": "integer"
          },
          "residual_risk_notes": {
            "type": "string"
          },
          "validation_status": {
            "type": "string",
            "enum": [
              "valid",
              "approved_fallback"
            ]
          },
          "fallback_reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "fallback_approved_by": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
