{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ft.rch.proof-ledger.evidence.schema.v3",
  "title": "FrankenTerm RCH Proof Ledger Evidence Schema",
  "type": "object",
  "required": [
    "schema_version",
    "bead_id",
    "policy_version",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "bead_id": {
      "type": "string",
      "pattern": "^ft-[A-Za-z0-9][A-Za-z0-9-]*(\\.[A-Za-z0-9][A-Za-z0-9-]*)*$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "command",
          "command_fingerprint",
          "command_class",
          "is_heavy",
          "used_rch",
          "worker_context",
          "worker_context_fingerprint",
          "execution_mode",
          "target_dir",
          "target_dir_fingerprint",
          "target_dir_lifecycle",
          "artifact_paths",
          "artifact_paths_fingerprint",
          "elapsed_seconds",
          "exit_status",
          "residual_risk_notes",
          "residual_risk_notes_fingerprint",
          "validation_status"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "command_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "command_class": {
            "type": "string",
            "enum": [
              "heavy",
              "light"
            ]
          },
          "is_heavy": {
            "type": "boolean"
          },
          "used_rch": {
            "type": "boolean"
          },
          "worker_context": {
            "type": "string",
            "minLength": 1
          },
          "worker_context_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "worker_evidence_confidence": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "target_worker_remote_proof",
              "target_worker_mirror_attestation",
              "scheduler_selected_remote_proof",
              "worker_self_test_only",
              "sync_or_transfer_only",
              "inconclusive_worker_evidence",
              "legacy_unknown_worker_evidence",
              null
            ]
          },
          "intended_worker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "selected_worker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "worker_queue_state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ready",
              "busy_wait",
              "unhealthy",
              "unsupported_worker_selection",
              "queue_timeout",
              "unknown",
              "not_applicable",
              null
            ]
          },
          "repo_snapshot_head": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([a-f0-9]{40}|unknown|not_applicable)$"
          },
          "source_mirror_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "present",
              "missing",
              "stale",
              "unreachable",
              "not_checked",
              "unknown",
              "not_applicable",
              null
            ]
          },
          "source_mirror_reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "remote_cargo_reached": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "remote_rustc_reached": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "test_binary_reached": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "execution_mode": {
            "type": "string",
            "enum": [
              "remote_rch",
              "local_light",
              "approved_local_fallback"
            ]
          },
          "target_dir": {
            "type": "string",
            "minLength": 1
          },
          "target_dir_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "target_dir_lifecycle": {
            "type": "string",
            "enum": [
              "not_applicable",
              "retained",
              "inventory_only",
              "cleanup_approved"
            ]
          },
          "artifact_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "artifact_paths_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "exit_status": {
            "type": "integer"
          },
          "residual_risk_notes": {
            "type": "string"
          },
          "residual_risk_notes_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "validation_status": {
            "type": "string",
            "enum": [
              "valid",
              "approved_fallback"
            ]
          },
          "fallback_reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "fallback_approved_by": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
