{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankenterm.dev/schemas/attestation/v1.json",
  "title": "FrankenTerm Release Attestation Bundle",
  "description": "Per-release content-addressed manifest of every reality-check artifact (perf, security, proofs, doctrine) plus a signature. Defined by ft-syqcz.1 (BR-RC-FOUNDATION.G3.1). Every claim ft makes in its README/AGENTS.md must be backed by an artifact listed here; the bundle is signed and any third party can re-derive the hashes offline.",
  "type": "object",
  "required": [
    "schema_version",
    "release",
    "generated_at",
    "generator",
    "git",
    "artifacts",
    "required_categories",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "Semver of this schema. Bumped on incompatible changes only.",
      "const": "1.0.0"
    },
    "release": {
      "type": "object",
      "required": ["version", "tag", "channel"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "description": "Semver release version, no leading 'v'.",
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.\\-]+)?(\\+[A-Za-z0-9.\\-]+)?$"
        },
        "tag": {
          "description": "Git tag (typically 'v<version>').",
          "type": "string",
          "pattern": "^v.+"
        },
        "channel": {
          "enum": ["stable", "beta", "nightly", "dev"]
        }
      }
    },
    "generated_at": {
      "description": "RFC 3339 timestamp the bundle was assembled.",
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "scripts/attestation-build.sh" },
        "version": { "type": "string" }
      }
    },
    "git": {
      "type": "object",
      "required": ["commit", "tree"],
      "additionalProperties": false,
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "branch": { "type": "string" }
      }
    },
    "artifacts": {
      "description": "Every artifact referenced by this bundle. Must contain at least one entry per category in required_categories. Dev-channel partial bundles MAY be empty.",
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "required_categories": {
      "description": "Categories this bundle commits to having delivered. Every entry MUST have at least one matching artifact (verify enforces). Production-channel bundles MUST list the canonical set in docs/attestations/manifest.json — verify --strict-required enforces this.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/category" }
    },
    "deferred_slots": {
      "description": "Required manifest slots intentionally deferred to a live recovery or producer bead. Release gates can reject these with --strict-deferred, but dev bundles expose them so third-party verifiers can audit the gap.",
      "type": "array",
      "items": { "$ref": "#/$defs/deferredSlot" },
      "default": []
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "category": {
      "description": "Reality-check artifact category. New categories require a schema bump.",
      "enum": [
        "perf/headline-claims",
        "perf/competitor-matrix",
        "perf/lindley-bounds",
        "tui/render-parity",
        "security/passive-watch",
        "security/redactor-coverage",
        "security/distributed-threat-model",
        "proofs/loom-runtime-async",
        "proofs/runtime-proof-trait",
        "proofs/robot-contracts",
        "doctrine/agents-md-counts",
        "doctrine/vendored-provenance",
        "doctrine/cx-propagation",
        "perf/atlas-packing"
      ]
    },
    "artifact": {
      "type": "object",
      "required": ["category", "path", "media_type", "sha256", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "category": { "$ref": "#/$defs/category" },
        "path": {
          "description": "Repo-relative POSIX path to the artifact at the bundle's git commit.",
          "type": "string",
          "pattern": "^[^/].*$"
        },
        "media_type": {
          "enum": [
            "application/json",
            "text/markdown",
            "application/x-tla+text",
            "application/x-tar",
            "text/plain"
          ]
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the artifact bytes.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "produced_by_bead": {
          "description": "Bead ID of the work item whose acceptance criteria gate this artifact.",
          "type": "string",
          "pattern": "^(ft|wa|br)-[a-z0-9.]+$"
        },
        "description": { "type": "string" }
      }
    },
    "deferredSlot": {
      "type": "object",
      "required": ["category", "media_type", "produced_by_bead", "deferred_to_bead", "deferred_reason"],
      "additionalProperties": false,
      "properties": {
        "category": { "$ref": "#/$defs/category" },
        "media_type": {
          "enum": [
            "application/json",
            "text/markdown",
            "application/x-tla+text",
            "application/x-tar",
            "text/plain"
          ]
        },
        "produced_by_bead": {
          "type": "string",
          "pattern": "^(ft|wa|br)-[a-z0-9.]+$"
        },
        "deferred_to_bead": {
          "type": "string",
          "pattern": "^ft-[a-z0-9.]+$"
        },
        "deferred_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": { "type": "string" }
      }
    },
    "sigstoreBundle": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Repo-relative path to the cosign sigstore bundle emitted beside the release attestation JSON.",
          "type": "string",
          "pattern": "^[^/].*$"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the sigstore bundle bytes. This binds the external .sigstore file to the signed JSON bundle.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "manifestSlot": {
      "type": "object",
      "required": ["category", "path", "media_type", "produced_by_bead", "description"],
      "additionalProperties": false,
      "properties": {
        "category": { "$ref": "#/$defs/category" },
        "path": {
          "description": "Repo-relative POSIX path to the artifact, or null only when deferred_to_bead and deferred_reason explain the live follow-up.",
          "oneOf": [
            { "type": "string", "pattern": "^[^/].*$" },
            { "type": "null" }
          ]
        },
        "media_type": {
          "enum": [
            "application/json",
            "text/markdown",
            "application/x-tla+text",
            "application/x-tar",
            "text/plain"
          ]
        },
        "produced_by_bead": {
          "type": "string",
          "pattern": "^(ft|wa|br)-[a-z0-9.]+$"
        },
        "deferred_to_bead": {
          "type": "string",
          "pattern": "^ft-[a-z0-9.]+$",
          "description": "When path is null, names the bead whose closure will populate this slot."
        },
        "deferred_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Short human-readable explanation of why the slot is deferred. Required when deferred_to_bead is set."
        },
        "description": { "type": "string" }
      },
      "oneOf": [
        {
          "properties": {
            "path": { "type": "string", "pattern": "^[^/].*$" }
          },
          "not": { "required": ["deferred_to_bead"] }
        },
        {
          "required": ["deferred_to_bead", "deferred_reason"],
          "properties": {
            "path": { "type": "null" }
          }
        }
      ]
    },
    "manifestPlaceholder": {
      "type": "object",
      "required": ["required_categories", "slots"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "_comment": { "type": "string" },
        "required_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/category" }
        },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/manifestSlot" }
        }
      }
    },
    "signature": {
      "type": "object",
      "required": ["method", "canonical_sha256"],
      "properties": {
        "method": {
          "enum": ["sigstore-cosign-keyless", "ed25519", "unsigned"]
        },
        "canonical_sha256": {
          "description": "SHA-256 of the canonical signing payload: the bundle JSON with the .signature field deleted, then `jq --sort-keys --compact-output` canonicalized.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "method": { "const": "sigstore-cosign-keyless" },
            "sigstore_bundle": { "$ref": "#/$defs/sigstoreBundle" },
            "certificate_identity": {
              "description": "Expected SAN/identity (typically the GitHub Actions workflow ref).",
              "type": "string"
            },
            "certificate_oidc_issuer": {
              "description": "Expected OIDC issuer (https://token.actions.githubusercontent.com for GitHub).",
              "type": "string",
              "format": "uri"
            }
          },
          "required": ["method", "sigstore_bundle", "certificate_identity", "certificate_oidc_issuer"]
        },
        {
          "properties": {
            "method": { "const": "ed25519" },
            "signature_path": {
              "description": "Repo-relative path to the raw 64-byte ed25519 signature, hex-encoded.",
              "type": "string"
            },
            "public_key": {
              "description": "32-byte ed25519 public key, hex-encoded.",
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["method", "signature_path", "public_key"]
        },
        {
          "properties": {
            "method": { "const": "unsigned" },
            "reason": {
              "description": "Why this bundle is unsigned. Must include a bead ID tracking the gap.",
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["method", "reason"]
        }
      ]
    }
  }
}
