+/* FrankenTerm additive authentication evidence, version 1. Stock authentication
+ * return values are unchanged. This is not an upstream libssh2 API.
+ * A failure snapshot exists only for the final response to a SIGNED public-key
+ * request. It is invalidated by the next public-key attempt and consumed by
+ * failure(). Calls require the same exclusive session ownership as userauth.
+ */
+#define LIBSSH2_FRANKENTERM_AUTH_EVIDENCE_VERSION 1
+#define LIBSSH2_FRANKENTERM_AUTH_METHODS_MAX 1024
+
+LIBSSH2_API unsigned int libssh2_frankenterm_auth_evidence_version(void);
+LIBSSH2_API libssh2_uint64_t
+libssh2_frankenterm_publickey_attempt(LIBSSH2_SESSION *session);
+/* Consumes proof of a valid unsigned refusal with partial_success=false.
+ * Returns that request's attempt number, or zero; never authorizes MFA. */
+LIBSSH2_API libssh2_uint64_t
+libssh2_frankenterm_publickey_unsigned_refusal(LIBSSH2_SESSION *session);
+/* Returns 1 for a copied snapshot, 0 for none, or a negative argument/capacity
+ * error. methods_capacity includes its trailing NUL. Any well-formed call
+ * consumes the snapshot, even when capacity is insufficient. No borrowed
+ * pointers, allocation, network I/O, or last-error mutation occurs.
+ */
+LIBSSH2_API int
+libssh2_frankenterm_publickey_failure(LIBSSH2_SESSION *session,
+                                    libssh2_uint64_t *attempt,
+                                    int *partial_success,
+                                    char *methods, size_t methods_capacity,
+                                    size_t *methods_length);
 
