+/* This additive API deliberately preserves all upstream userauth return codes.
+ * Never expose the response to "none", an unsigned key offer, or a signing /
+ * transport error as signed-key evidence. A separate consuming marker proves
+ * unsigned refusal only when its bounded packet has partial_success=false.
+ */
+static void
+frankenterm_clear_publickey_failure(LIBSSH2_SESSION *session)
+{
+    session->ft_auth_failure_valid = 0;
+    session->ft_auth_failure_attempt = 0;
+    session->ft_auth_unsigned_refusal_attempt = 0;
+    session->ft_auth_partial_success = 0;
+    session->ft_auth_methods_length = 0;
+    memset(session->ft_auth_methods, 0, sizeof(session->ft_auth_methods));
+}
+
+static void
+frankenterm_record_publickey_failure(LIBSSH2_SESSION *session,
+                                    const unsigned char *packet,
+                                    size_t packet_length, int signed_request)
+{
+    size_t length, i;
+    frankenterm_clear_publickey_failure(session);
+    if(!packet || packet_length < 6 ||
+       packet[0] != SSH_MSG_USERAUTH_FAILURE ||
+       !session->ft_auth_attempt || session->ft_auth_attempt_exhausted)
+        return;
+    length = _libssh2_ntohu32(packet + 1);
+    /* Subtract only after the minimum extent check; never index using an
+     * untrusted SSH string length before checking the complete packet. */
+    if(length > LIBSSH2_FRANKENTERM_AUTH_METHODS_MAX ||
+       length != packet_length - 6)
+        return;
+    for(i = 0; i < length; i++) {
+        unsigned char value = packet[5 + i];
+        if(value < 33 || value > 126 ||
+           (value == ',' && (!i || packet[4 + i] == ',')))
+            return;
+    }
+    if(length && packet[4 + length] == ',')
+        return;
+    if(!signed_request) {
+        if(!packet[5 + length])
+            session->ft_auth_unsigned_refusal_attempt =
+                session->ft_auth_attempt;
+        return;
+    }
+    memcpy(session->ft_auth_methods, packet + 5, length);
+    session->ft_auth_methods[length] = 0;
+    session->ft_auth_methods_length = length;
+    /* SSH boolean is false for zero and true for any nonzero byte. */
+    session->ft_auth_partial_success = packet[5 + length] != 0;
+    session->ft_auth_failure_attempt = session->ft_auth_attempt;
+    session->ft_auth_failure_valid = 1;
+}
+
+LIBSSH2_API unsigned int
+libssh2_frankenterm_auth_evidence_version(void)
+{
+    return LIBSSH2_FRANKENTERM_AUTH_EVIDENCE_VERSION;
+}
+
+LIBSSH2_API libssh2_uint64_t
+libssh2_frankenterm_publickey_attempt(LIBSSH2_SESSION *session)
+{
+    return session ? session->ft_auth_attempt : 0;
+}
+
+LIBSSH2_API libssh2_uint64_t
+libssh2_frankenterm_publickey_unsigned_refusal(LIBSSH2_SESSION *session)
+{
+    libssh2_uint64_t attempt;
+    if(!session)
+        return 0;
+    attempt = session->ft_auth_unsigned_refusal_attempt;
+    session->ft_auth_unsigned_refusal_attempt = 0;
+    return attempt;
+}
+
+LIBSSH2_API int
+libssh2_frankenterm_publickey_failure(LIBSSH2_SESSION *session,
+                                    libssh2_uint64_t *attempt,
+                                    int *partial_success,
+                                    char *methods, size_t methods_capacity,
+                                    size_t *methods_length)
+{
+    int result;
+    if(!session || !attempt || !partial_success ||
+       !methods || !methods_capacity || !methods_length)
+        return LIBSSH2_ERROR_INVAL;
+    *attempt = 0;
+    *partial_success = 0;
+    *methods_length = 0;
+    methods[0] = 0;
+    result = session->ft_auth_failure_valid;
+    if(result) {
+        *attempt = session->ft_auth_failure_attempt;
+        *partial_success = session->ft_auth_partial_success;
+        *methods_length = session->ft_auth_methods_length;
+        if(methods_capacity <= session->ft_auth_methods_length)
+            result = LIBSSH2_ERROR_BUFFER_TOO_SMALL;
+        else
+            memcpy(methods, session->ft_auth_methods,
+                   session->ft_auth_methods_length + 1);
+    }
+    frankenterm_clear_publickey_failure(session);
+    return result;
+}
