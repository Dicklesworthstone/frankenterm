+/* Exact request names are distinct from key-blob and signature-wrapper names.
+ * This check is deliberately outside the upgrade helper: it must cover the
+ * no-extension, legacy-server, and second-attempt fallback paths too. */
+static int
+frankenterm_publickey_algorithm_permitted(LIBSSH2_SESSION *session,
+                                        const unsigned char *method,
+                                        size_t method_length)
+{
+    size_t start = 0;
+    if(!session->ft_publickey_policy_active)
+        return 1;
+    if(!method || !method_length)
+        return 0;
+    while(start < session->ft_publickey_policy_length) {
+        size_t end = start;
+        while(end < session->ft_publickey_policy_length &&
+              session->ft_publickey_algorithms[end] != ',')
+            end++;
+        if(end - start == method_length &&
+           !memcmp(session->ft_publickey_algorithms + start,
+                   method, method_length))
+            return 1;
+        start = end + 1;
+    }
+    return 0;
+}
+
+LIBSSH2_API unsigned int
+libssh2_frankenterm_publickey_policy_version(void)
+{
+    return LIBSSH2_FRANKENTERM_PUBLICKEY_POLICY_VERSION;
+}
+
+LIBSSH2_API int
+libssh2_frankenterm_publickey_policy(LIBSSH2_SESSION *session,
+                                   const char *algorithms, size_t length)
+{
+    size_t i, component = 0;
+    if(!session || (!algorithms && length) ||
+       length >= LIBSSH2_FRANKENTERM_PUBLICKEY_ALGORITHMS_MAX ||
+       session->userauth_pblc_state != libssh2_NB_state_idle ||
+       (session->state & LIBSSH2_STATE_AUTHENTICATED))
+        return LIBSSH2_ERROR_INVAL;
+    for(i = 0; i < length; i++) {
+        unsigned char value = (unsigned char)algorithms[i];
+        if(value == ',') {
+            if(!component || i + 1 == length)
+                return LIBSSH2_ERROR_INVAL;
+            component = 0;
+        }
+        else {
+            if(value < 33 || value > 126 || ++component > 64)
+                return LIBSSH2_ERROR_INVAL;
+        }
+    }
+    session->ft_publickey_policy_active = algorithms != NULL;
+    session->ft_publickey_policy_length = length;
+    memset(session->ft_publickey_algorithms, 0,
+           sizeof(session->ft_publickey_algorithms));
+    if(length)
+        memcpy(session->ft_publickey_algorithms, algorithms, length);
+    return 0;
+}
