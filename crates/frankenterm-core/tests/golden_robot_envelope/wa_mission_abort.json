{
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "error_code": {
        "description": "Optional error code for the abort",
        "type": "string"
      },
      "expected_token": {
        "type": "object",
        "description": "Exact revision_token from wa.mission_state. Stale content, revision, or incarnation is rejected. Preserve revision as decimal text.",
        "additionalProperties": false,
        "required": ["mission_id", "generation", "revision", "content_sha256"],
        "properties": {
          "mission_id": { "type": "string" },
          "generation": { "type": "string" },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "maxLength": 20
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "format": {
        "maxLength": 16,
        "description": "Optional output format override for this call",
        "enum": [
          "json",
          "toon"
        ],
        "type": "string"
      },
      "mission_file": {
        "type": "string",
        "description": "Optional path to mission JSON (default: .ft/mission/active.json)"
      },
      "reason": {
        "description": "Reason code for the abort (required)",
        "type": "string"
      },
      "requested_by": {
        "description": "Who requested the abort (default: mcp-agent)",
        "type": "string"
      }
    },
    "required": [
      "reason"
    ],
    "type": "object"
  },
  "invalid_args_envelope": {
    "elapsed_ms": 0,
    "error": "Cannot abort mission: invalid mission lifecycle transition: cancelled --cancel--> ?",
    "error_code": "FT-MCP-0001",
    "hint": "Use wa.mission_explain to see valid transitions.",
    "mcp_version": "v1",
    "now": 0,
    "ok": false,
    "version": "0.15.2"
  },
  "success_envelope": {
    "data": {
      "command": "abort",
      "decision_path": "abort",
      "error_code": "mission.failure.manual_abort",
      "lifecycle_from": "running",
      "lifecycle_to": "cancelled",
      "mission_file": "<mission_file>",
      "mission_hash": "<verified_content_hash>",
      "mission_id": "mission:qiba0",
      "mutation": {
        "changed": true,
        "current": {
          "content_sha256": "<verified_content_hash>",
          "generation": "0123456789abcdef0123456789abcdef",
          "mission_id": "mission:qiba0",
          "revision": "1"
        },
        "durability": "file_and_directory_synced",
        "owner_acknowledgement": "unavailable_no_mission_driver",
        "previous": {
          "content_sha256": "<verified_content_hash>",
          "generation": "0123456789abcdef0123456789abcdef",
          "mission_id": "mission:qiba0",
          "revision": "0"
        }
      },
      "reason_code": "operator_abort"
    },
    "elapsed_ms": 0,
    "mcp_version": "v1",
    "now": 0,
    "ok": true,
    "version": "0.15.2"
  },
  "tool": "wa.mission_abort"
}
