    {
      "annotations": null,
      "description": "Wait for a pattern match in pane output (robot parity)",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "description": "Optional output format override for this call",
            "enum": [
              "json",
              "toon"
            ],
            "type": "string"
          },
          "pane_id": {
            "description": "Pane ID to wait on",
            "minimum": 0,
            "type": "integer"
          },
          "pattern": {
            "description": "Pattern to match (substring or regex)",
            "type": "string"
          },
          "regex": {
            "default": false,
            "description": "Treat pattern as regex",
            "type": "boolean"
          },
          "tail": {
            "default": 200,
            "description": "Tail lines to search (0 = full buffer)",
            "minimum": 0,
            "type": "integer"
          },
          "timeout_secs": {
            "default": 30,
            "description": "Timeout in seconds",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "pane_id",
          "pattern"
        ],
        "type": "object"
      },
      "name": "wa.wait_for",
      "output_schema": null,
      "tags": [
        "wa",
        "robot"
      ],
      "version": "0.1.0"
