          },
          "item_id": {
            "description": "Attention item id to explain when surface=explain",
            "type": "string"
          },
          "surface": {
            "default": "status",
            "enum": [
              "status",
              "next",
              "explain"
            ],
            "type": "string"
          },
          "workspace": {
            "description": "Workspace label used only when input is omitted or workspace override is desired",
            "type": "string"
          }
        },
        "type": "object"
      },
