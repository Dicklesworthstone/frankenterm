    {
      "annotations": null,
      "description": "Read attention-router status, next action, or item explanation from caller-supplied evidence (robot parity)",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "description": "Optional output format override for this call",
            "enum": [
              "json",
              "toon"
            ],
            "maxLength": 16,
            "type": "string"
          },
          "generated_at_ms": {
            "minimum": 0,
            "type": "integer"
          },
          "input": {
            "description": "AttentionRouterSourceAdapterInput object; omitted input yields an explicit degraded no-input snapshot",
