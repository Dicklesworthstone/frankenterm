  "tools": [
    {
      "annotations": null,
      "description": "Search coding agent session history via cass",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "description": "Agent filter: codex|claude_code|gemini|cursor|aider|chatgpt",
            "type": "string"
          },
          "days": {
            "description": "Only sessions within the last N days",
            "minimum": 0,
            "type": "integer"
          },
          "fields": {
            "description": "Field selection (cass-defined; e.g. minimal)",
            "type": "string"
          },
          "format": {
            "description": "Optional output format override for this call",
            "enum": [
              "json",
              "toon"
            ],
            "type": "string"
          },
          "limit": {
            "default": 10,
            "description": "Maximum results (0 = cass default)",
            "maximum": 1000,
            "minimum": 0,
            "type": "integer"
          },
          "max_tokens": {
            "description": "Max tokens per hit content (cass-defined)",
            "minimum": 0,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "Offset into results",
            "minimum": 0,
            "type": "integer"
          },
          "query": {
            "description": "Search query string",
            "type": "string"
          },
          "timeout_secs": {
            "default": 15,
            "description": "cass timeout override (seconds)",
            "maximum": 600,
            "minimum": 1,
            "type": "integer"
          },
          "workspace": {
            "description": "Workspace filter (cass-defined)",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "wa.cass_search",
      "output_schema": null,
      "tags": [
        "wa",
        "robot",
        "cass"
      ],
      "version": "0.1.0"
    },
    {
      "annotations": null,
      "description": "Check cass index status",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "description": "Optional output format override for this call",
            "enum": [
              "json",
              "toon"
            ],
            "type": "string"
          },
          "timeout_secs": {
            "default": 15,
            "description": "cass timeout override (seconds)",
            "maximum": 600,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "wa.cass_status",
      "output_schema": null,
      "tags": [
        "wa",
        "robot",
        "cass"
      ],
      "version": "0.1.0"
    },
    {
      "annotations": null,
      "description": "View context for a cass search hit",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "context_lines": {
            "default": 10,
            "description": "Context lines before/after match",
            "minimum": 0,
            "type": "integer"
          },
          "format": {
            "description": "Optional output format override for this call",
            "enum": [
              "json",
              "toon"
            ],
            "type": "string"
          },
          "line_number": {
            "description": "Line number returned by cass search",
            "minimum": 0,
            "type": "integer"
          },
          "source_path": {
            "description": "Source path returned by cass search",
            "type": "string"
          },
          "timeout_secs": {
            "default": 15,
            "description": "cass timeout override (seconds)",
            "maximum": 600,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "source_path",
          "line_number"
        ],
        "type": "object"
      },
      "name": "wa.cass_view",
      "output_schema": null,
      "tags": [
        "wa",
        "robot",
        "cass"
      ],
      "version": "0.1.0"
    },
    {
      "annotations": null,
      "description": "Get text content from a pane (robot parity)",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "escapes": {
            "default": false,
            "description": "Include escape sequences",
            "type": "boolean"
          },
          "format": {
            "description": "Optional output format override for this call",
            "enum": [
              "json",
              "toon"
            ],
            "type": "string"
          },
          "pane_id": {
            "description": "The pane ID to read from",
            "minimum": 0,
            "type": "integer"
          },
          "tail": {
            "default": 500,
            "description": "Number of lines to return (from end)",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "pane_id"
        ],
        "type": "object"
      },
      "name": "wa.get_text",
      "output_schema": null,
      "tags": [
        "wa",
        "robot"
      ],
      "version": "0.1.0"
    },
    {
