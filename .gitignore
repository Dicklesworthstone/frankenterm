# Rust build artifacts
target/
target-*/
**/*.rs.bk
Cargo.lock.bak

# Tracked Cargo config lives in .cargo/config.toml; use the example/template
# and extra per-agent override files for machine-local adjustments.

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# macOS resource forks
._*

# Environment and secrets
.env
.env.*
*.pem
*.key

# Beads viewer local config
.bv/

# Beads lock files (bv viewer lock, br sync lock, etc.)
.beads/*.lock

# Legacy WezTerm source (vendored for reference)
legacy_wezterm/

# Legacy Ghostty source (vendored for reference)
legacy_ghostty/

# Legacy Zellij source (vendored for reference)
legacy_zellij/

# Legacy Rio source (vendored for reference)
legacy_rio/

# SQLite databases (runtime)
*.db
*.db-journal
*.db-wal
*.db-shm

# Log files
*.log
logs/

# Test artifacts
test_output/
coverage/
*.profraw
*.profdata
# Golden/conformance drift artifacts written next to checked-in fixtures.
*.actual.json
*.actual.toon
*.actual.plain
*.actual.bin
crates/frankenterm-core/tests/fixtures/mcp_manifest_no_db.actual.json

# Temporary files
tmp/
temp/
*.tmp

# Generated documentation (build on demand)
doc/
.ntm/

# E2E test artifacts (runtime)
e2e-artifacts/

# Local ft runtime/config
.ft/

# Fuzzing artifacts
fuzz/artifacts/

# Compiled binaries
a.out

# Agent-named target directories (concurrent agent builds)
target_*/

# bv triage artifacts (auto-generated, ephemeral)
brief.md
helpers.md
insights.json
meta.json
!tests/golden/gpu/**/meta.json
triage.json

# Proptest regression files (auto-generated, machine-specific)
**/proptest-regressions/
*.proptest-regressions

# TLA+ model checker generated state files (multi-GB, regeneratable)
docs/formal/states/
docs/formal/*.tlc.log

# WezTerm Automata runtime state (backups, locks)
.wa/

# Per-agent Cargo caches (concurrent agent builds use isolated registries)
.cargo_*/
.cargo-*/

# Remote compilation helper cache and build artifacts
.rch/
.rch-target/

# Agent mail SQLite databases (runtime state, not project data)
storage.sqlite3
storage.sqlite3-*
storage.sqlite3.bak

# Beads backup files (auto-generated during sync/migration)
.beads/*.bak*

# Codegen sub-crate lock files (generated, not the workspace root Cargo.lock)
**/codegen/Cargo.lock

# ML model caches (fastembed, ONNX, etc.)
.fastembed_cache/
.onnx_cache/

# macOS app bundles (build output)
*.app/

# Scratch/throwaway files (agent experiments, one-off debugging)
*.orig
*.patch
*.bak
/test_*
.write_probe
**/test_bug.rs
**/test_deadlock.rs
**/*_bug_test.rs
**/*_test_bug.rs
/frankenredis/

# Agent worktree target directories (dot-prefixed)
.target-*/

# Agent mail project ID (runtime state)
.agent-mail-project-id

# MCP config files (editor/agent-specific, contain local paths/tokens)
*.mcp.json
opencode.json

# Agent-generated Python scripts (one-off fix/refactor/update tools)
fix_*.py
refactor_*.py
update_*.py

# E2E test artifacts (runtime output)
tests/e2e/artifacts/

# UBS (Ultimate Bug Scanner) reports
ubs*.txt

# Ephemeral regex/test scratch directories (agent experiments)
tmp_re_test/

# git-stash-janitor skill scratch workspace (inventories, triage tsvs,
# handoff reports). Always ephemeral; recreated each run.
/.stash_janitor_workspace/

# Timestamped RCH probe/smoke/queue log dumps written next to docs/
# during remote-compilation rollouts. The schema and policy docs at
# docs/asupersync-rch-* ARE committed; only the timestamped run dirs
# (rch-YYYYMMDDTHHMMSSZ-NNNNN) are ignored.
/docs/rch-*/

# Finish-line-guard run artifacts (per-run guard-results-*.json,
# shell.log dumps, artifact-contract.json). The guard contract itself
# lives elsewhere under docs/; only the timestamped run dirs are ephemeral.
/docs/finish-line-guard-artifacts/

# Agent tool MCP config backups (timestamped .bak files)
.claude/*.bak
.cline.mcp.json.*
.codex.mcp.json.*
.cursor.mcp.json.*
.gemini.mcp.json.*
.opencode.json.*
.windsurf.mcp.json.*
.claude/settings.local.json

# Beads recovery directories
.beads/.br_recovery/
.beads/recovery_*/

# Top-level artifacts directory (agent work products, bead artifacts)
/artifacts/

# Python bytecode cache
**/__pycache__/

# E2E test output directory (timestamped JSON results, watch logs)
tests/e2e/output/

# Claude Code runtime lock files
.claude/*.lock

# Clippy analysis output (all variants)
clippy_*.json
clippy_*.txt
*_clippy.json

# Check/build analysis output
check_out.json

# UBS scan output (JSON and text dumps)
ubs_*.json
ubs_*.txt

# Ephemeral env file at repo root
/env

# Agent-generated scratch Rust files at repo root
# Tracked reproductions live under scratch/ — see scratch/README.md.
/dump_sender.rs
/test_*.rs

# Stray zero-byte files created by accidental shell redirection
# (e.g. `cmd > 0` or piping to a literal fd number). These are never
# legitimate repo content; if they appear, they're shell mishaps.
/0
/1
/2

# Loose SQLite databases at repo root (runtime artifacts, backups,
# corrupt-snapshot files). Actual workspace databases live in
# ~/.local/share/frankenterm/ via workspace_layout().
/storage.sqlite3
/storage.sqlite3-*
/storage.sqlite3.bak

# Local dev attestation bundles produced by scripts/attestation-build.sh.
# Real release bundles (everything except the dev / smoke / test examples)
# MUST be committed. See docs/attestations/README.md.
/docs/attestations/0.0.0-dev*.json
/docs/attestations/0.0.0-dev*.sigstore
/docs/attestations/0.0.0-dev*.canonical.json
/docs/attestations/0.0.0-smoke*.json
/docs/attestations/0.0.0-smoke*.sigstore
/docs/attestations/0.0.0-smoke*.canonical.json
