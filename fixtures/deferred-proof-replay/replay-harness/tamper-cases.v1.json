      "expected_decision": "reject_non_remote_command",
      "forbidden_decisions": ["would_run_remote", "run_static_now"],
      "receipt": {
        "bead_id": "ft-tamper-localcargo",
        "receipt_id": "ft-tamper-localcargo:1",
        "command": {
          "command_shape_version": "rch-no-self-healing-v1",
          "argv": ["cargo", "test", "-p", "frankenterm-core", "policy"],
          "env": [{"name": "RCH_REQUIRE_REMOTE", "value": "1"}],
          "target_dir": "/tmp/ft-tamper-localcargo",
          "material_remote_required": true
        },
        "proof": {"material_cargo_required": true, "evidence_classification": "blocked_infra"},
        "paths": {"dirty_paths_at_capture": []},
        "coordination": {"rch_admission_state": "admitted", "operator_cancelled": false, "prerequisite_beads": []},
        "eligibility": {"state": "eligible", "replay_allowed": true}
      }
    },
    {
