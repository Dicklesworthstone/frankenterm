    {
      "field": "workspace_root",
      "replacement": "unknown",
      "reason": "developer checkout paths differ across machines"
    },
    {
      "field": "elapsed_ms",
      "replacement": "omitted from planner input",
      "reason": "source command runtime is non-contractual"
    },
    {
      "field": "worker_id",
      "replacement": "redacted-worker",
      "reason": "RCH worker identities are machine-local"
    },
    {
      "field": "machine_id",
      "replacement": "redacted-machine",
      "reason": "host identity must not be part of the golden"
    }
